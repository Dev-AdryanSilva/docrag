# Copie este arquivo para .env e preencha os valores.
# O arquivo .env NUNCA deve ser commitado.

# --- Chave do Gemini (crie em https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=cole_sua_chave_aqui

# --- Chave simples para proteger os endpoints de escrita (header X-API-Key) ---
API_KEY=troque-por-uma-chave-secreta

# --- Opcionais: descomente para mudar os valores padrão (ver app/config.py) ---
# GEMINI_MODEL=gemini-3.1-flash-lite
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# TOP_K=4
# SIMILARITY_THRESHOLD=0.25
# HISTORY_TURNS=4

# --- PostgreSQL (usado pelo docker compose) ---
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot
