FROM python:3.12-slim

WORKDIR /code

# Tesseract com o idioma português: faz o OCR de PDFs escaneados (páginas que são só imagem)
RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-por \
    && rm -rf /var/lib/apt/lists/*

# Instala as dependências primeiro para aproveitar o cache de camadas do Docker
COPY requirements.txt .
# O índice extra traz o torch só para CPU (bem menor que a versão com CUDA)
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu -r requirements.txt

COPY app ./app

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
